# Copy this file to .env and adjust values as needed.
IDLE_CHECK_INTERVAL_MS=300000
IDLE_THRESHOLD_SECONDS=540
# Supported aliases: all_week, weekend, working_days.
IDLE_DAYS=mon,wed,thu,fri
IDLE_START_TIME=07:00
IDLE_END_TIME=17:00
IDLE_TIMEZONE=America/Monterrey
IDLE_ACTION=hid-event
# IDLE_LOG_FILE=/absolute/path/to/mac-idle-keeper.log

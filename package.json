{
  "name": "mac-idle-keeper",
  "version": "1.4.0",
  "private": false,
  "packageManager": "pnpm@11.18.0",
  "description": "Checks macOS system idle time on a weekday schedule and prevents long idle periods.",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "bin": {
    "mac-idle-keeper": "bin/mac-idle-keeper.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymundo-salazar/mac-idle-keeper.git"
  },
  "bugs": {
    "url": "https://github.com/raymundo-salazar/mac-idle-keeper/issues"
  },
  "homepage": "https://github.com/raymundo-salazar/mac-idle-keeper",
  "keywords": [
    "macos",
    "idle",
    "activity",
    "launchagent",
    "cli",
    "electron"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:test": "IDLE_ENV_FILE=.env.test electron .",
    "check": "node --test --test-reporter spec",
    "launch-agent:install": "node scripts/install-launch-agent.js",
    "launch-agent:status": "node scripts/manage-launch-agent.js status",
    "launch-agent:logs": "node scripts/view-logs.js",
    "launch-agent:stop": "node scripts/manage-launch-agent.js stop",
    "launch-agent:pause": "node scripts/manage-launch-agent.js pause",
    "launch-agent:resume": "node scripts/manage-launch-agent.js resume",
    "launch-agent:restart": "node scripts/manage-launch-agent.js restart",
    "launch-agent:uninstall": "node scripts/manage-launch-agent.js uninstall"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron": "^42.11.10"
  }
}
